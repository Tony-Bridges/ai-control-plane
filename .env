# .env
APP_NAME=AI Control Plane
DEBUG=true
SECRET_KEY=your-secret-key-here-change-in-production

# PostgreSQL (both naming conventions)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_control_plane
POSTGRES_USER=postgres
POSTGRES_PASSWORD=00000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=ai_control_plane
DB_USER=postgres
DB_PASSWORD=your-password-here

# Database URL (optional - will be built from above if not provided)
DATABASE_URL=postgresql://postgres:your-password-here@localhost:5432/ai_control_plane

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# OPA
OPA_URL=http://localhost:8181

# OpenAI
OPENAI_ENDPOINT=https://api.openai.com/v1
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_ORG_ID=your-org-id-here
OPENAI_TIMEOUT=30
OPENAI_MAX_RETRIES=3
DEFAULT_MODEL=gpt-4
FALLBACK_MODEL=gpt-3.5-turbo

# Anthropic
ANTHROPIC_ENDPOINT=https://api.anthropic.com/v1
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_TIMEOUT=30
ANTHROPIC_MAX_RETRIES=3
ANTHROPIC_DEFAULT_MODEL=claude-3-opus-20240229

# Google
GOOGLE_ENDPOINT=https://generativelanguage.googleapis.com/v1
GOOGLE_API_KEY=your-google-api-key-here

# Local Llama
LOCAL_LLAMA_ENDPOINT=http://localhost:11434/api
LOCAL_LLAMA_MODEL=llama2
LOCAL_LLAMA_TIMEOUT=60
LOCAL_LLAMA_MAX_RETRIES=2
LOCAL_DEFAULT_MODEL=llama2

# CORS
#ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000

# Logging
LOG_LEVEL=INFO