4. Configuration {#configuration}
Environment Variables
Create a .env file in the root directory:

bash
# ============ APPLICATION ============
APP_NAME=AI Control Plane
DEBUG=true
SECRET_KEY=your-secret-key-here-change-in-production
LOG_LEVEL=INFO

# ============ DATABASE ============
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ai_control_plane
DB_USER=postgres
DB_PASSWORD=your-password

# ============ REDIS ============
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ============ OPA ============
OPA_URL=http://localhost:8181

# ============ AI PROVIDERS ============
# OpenAI
OPENAI_ENDPOINT=https://api.openai.com/v1
OPENAI_API_KEY=your-openai-api-key
DEFAULT_MODEL=gpt-4
FALLBACK_MODEL=gpt-3.5-turbo

# Anthropic
ANTHROPIC_ENDPOINT=https://api.anthropic.com/v1
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_DEFAULT_MODEL=claude-3-opus-20240229

# Google AI
GOOGLE_ENDPOINT=https://generativelanguage.googleapis.com/v1
GOOGLE_API_KEY=your-google-api-key

# Local Models (Ollama)
LOCAL_LLAMA_ENDPOINT=http://localhost:11434/api
LOCAL_LLAMA_MODEL=llama2

# ============ CORS ============
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ============ RATE LIMITING ============
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60
Configuration File
Alternatively, use config.yaml:

yaml
# config.yaml
application:
  name: AI Control Plane
  debug: true
  secret_key: your-secret-key

database:
  host: localhost
  port: 5432
  name: ai_control_plane
  user: postgres
  password: your-password

ai_providers:
  openai:
    endpoint: https://api.openai.com/v1
    api_key: your-key
    default_model: gpt-4
  anthropic:
    endpoint: https://api.anthropic.com/v1
    api_key: your-key
    default_model: claude-3-opus-20240229

policies:
  opa_url: http://localhost:8181
  auto_reload: true

rate_limiting:
  requests_per_minute: 60
