9. Troubleshooting {#troubleshooting}
Common Issues
1. Application won't start
bash
# Check if port is in use
lsof -i :8000

# Check Python version
python --version  # Should be 3.10+

# Check dependencies
pip list | grep -E "fastapi|uvicorn|spacy"
2. Database connection errors
bash
# Check PostgreSQL is running
brew services list | grep postgres

# Test connection
psql -h localhost -U postgres -d ai_control_plane

# Reset database
createdb ai_control_plane
3. OPA errors
bash
# Check OPA is running
curl http://localhost:8181/v1/data

# Reload policies
curl -X POST http://localhost:8181/v1/policies

# Check OPA logs
opa run --server --log-level debug
4. Dashboard not connecting
bash
# Check API URL in sidebar
# Should be: http://localhost:8000

# Check CORS settings
# Ensure allowed_origins includes http://localhost:8501

# Restart dashboard
streamlit run policy_dashboard.py
5. PII not being detected
python
# Test spaCy model
python -c "import spacy; nlp = spacy.load('en_core_web_lg'); print('ok')"

# Check recognizers
python -c "from src.detectors.classification_engine import ClassificationEngine; ce = ClassificationEngine(); print(ce.registry.recognizers)"
Debug Mode
Enable debug logging:

bash
# In .env
DEBUG=true
LOG_LEVEL=DEBUG

# Or run with debug flag
uvicorn src.main:app --reload --log-level debug
Logs
bash
# View application logs
tail -f logs/app.log

# View uvicorn logs
uvicorn src.main:app --reload --log-level info

# Dashboard logs
streamlit run policy_dashboard.py --logger.level=debug
