Error Codes
Code	Description
400	Bad Request - Invalid input
401	Unauthorized - Missing tenant ID
403	Forbidden - Policy denied access
404	Not Found - Resource not found
429	Too Many Requests - Rate limit exceeded
500	Internal Server Error
6. Policy Management {#policy-management}
OPA Policy Language
Policies are written in Rego, OPA's policy language.

Policy Structure
rego
package privacy

# Default allow
default allow = true

# Block requests with PII
allow {
    not contains_pii(input.text)
}

# PII detection rules
contains_pii(text) {
    contains_id_number(text)
}

contains_pii(text) {
    contains_email(text)
}

# South African ID
contains_id_number(text) {
    regex.match("\\b\\d{2}\\s?\\d{2}\\s?\\d{2}\\s?\\d{2}\\s?\\d{2}\\s?\\d{2}\\s?\\d{3}\\s?\\d{1}\\b", text)
}

# Email detection
contains_email(text) {
    regex.match("\\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Z|a-z]{2,}\\b", text)
}
Common Policy Examples
Access Control
rego
package access

allow_access(user, resource) {
    user.role == "admin"
}

allow_access(user, resource) {
    user.role == "manager"
    resource.department == user.department
}

allow_access(user, resource) {
    user.role == "viewer"
    resource.public == true
}
Rate Limiting
rego
package ratelimit

max_requests = 60

allow {
    count(input.requests_in_minute) < max_requests
}
Data Classification
rego
package classification

classify_text(text) = "sensitive" {
    contains_pii(text)
}

classify_text(text) = "public" {
    not contains_pii(text)
}
